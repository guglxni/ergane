# InventionGuard Configuration

# LLM (OpenAI-compatible)
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
INVENTIONGUARD_MODEL=gpt-4o
INVENTIONGUARD_NOVELTY_THRESHOLD=0.4

# Patent Database APIs
USPTO_API_KEY=your_uspto_key  # Optional (USPTO ODP is free)
EPO_CONSUMER_KEY=your_epo_key
EPO_CONSUMER_SECRET=your_epo_secret

# Semantic Search
PQAI_API_KEY=  # Optional (basic use is free)

# Notifications
OPENCLAW_WEBHOOK_URL=https://openclaw.gateway/webhook/invention

# Memory
GBRAIN_MCP_URL=http://localhost:3000/mcp

# GitHub (for Action / Issue creation)
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=your-org/your-repo
